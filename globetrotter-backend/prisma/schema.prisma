datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id              Int      @id @default(autoincrement())
  firstName       String   @map("first_name")
  lastName        String   @map("last_name")
  email           String   @unique
  phone           String?
  city            String?
  country         String?
  additionalInfo  String?  @map("additional_info") @db.Text
  passwordHash    String   @map("password_hash")
  profilePhoto    String?  @map("profile_photo")
  languagePref    String?  @map("language_pref")
  createdAt       DateTime @default(now()) @map("created_at")
  trips           Trip[]
  @@map("users")
  isAdmin   Boolean @default(false) @map("is_admin")
  isActive  Boolean @default(true)  @map("is_active")
}

model Trip {
  id          Int      @id @default(autoincrement())
  userId      Int      @map("user_id")
  name        String
  startDate   DateTime @map("start_date")
  endDate     DateTime @map("end_date")
  description String?  @db.Text
  coverPhoto  String?  @map("cover_photo")
  isPublic    Boolean  @default(false) @map("is_public")
  shareSlug   String?  @unique @map("share_slug")
  createdAt   DateTime @default(now()) @map("created_at")
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  stops       TripStop[]
  @@map("trips")
}

model City {
  id         Int        @id @default(autoincrement())
  name       String
  country    String
  region     String?
  costIndex  Int?       @map("cost_index")
  popularity Int        @default(0)
  imageUrl   String?    @map("image_url")
  stops      TripStop[]
  activities Activity[]
  savedBy    UserSavedCity[]
  @@map("cities")
}

model TripStop {
  id               Int      @id @default(autoincrement())
  tripId           Int      @map("trip_id")
  cityId           Int      @map("city_id")
  startDate        DateTime @map("start_date")
  endDate          DateTime @map("end_date")
  orderIndex       Int      @map("order_index")
  budgetForSection Float?   @map("budget_for_section")
  createdAt        DateTime @default(now()) @map("created_at")
  trip             Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  city             City     @relation(fields: [cityId], references: [id])
  activities       TripStopActivity[]
  @@map("trip_stops")
}

model Activity {
  id          Int     @id @default(autoincrement())
  cityId      Int     @map("city_id")
  name        String
  category    String
  cost        Float
  duration    String?
  description String? @db.Text
  imageUrl    String? @map("image_url")
  city        City    @relation(fields: [cityId], references: [id])
  tripStops   TripStopActivity[]
  @@map("activities")
}

model TripStopActivity {
  id             Int       @id @default(autoincrement())
  tripStopId     Int       @map("trip_stop_id")
  activityId     Int       @map("activity_id")
  scheduledDate  DateTime? @map("scheduled_date")
  scheduledTime  String?   @map("scheduled_time")
  costOverride   Float?    @map("cost_override")
  tripStop       TripStop  @relation(fields: [tripStopId], references: [id], onDelete: Cascade)
  activity       Activity  @relation(fields: [activityId], references: [id])
  @@map("trip_stop_activities")
}

model Budget {
  id        Int      @id @default(autoincrement())
  tripId    Int      @map("trip_id")
  category  String
  amount    Float
  createdAt DateTime @default(now()) @map("created_at")
  @@map("budgets")
}

// === END OF MEMBER A MODELS — Member B appends below ===
model CommunityPost {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  tripId    Int?     @map("trip_id")
  content   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  comments  CommunityComment[]
  likes     CommunityLike[]
  @@map("community_posts")
}

model CommunityComment {
  id        Int      @id @default(autoincrement())
  postId    Int      @map("post_id")
  userId    Int      @map("user_id")
  content   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  @@map("community_comments")
}

model CommunityLike {
  id        Int      @id @default(autoincrement())
  postId    Int      @map("post_id")
  userId    Int      @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  @@unique([postId, userId])
  @@map("community_likes")
}

model UserSavedCity {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  cityId    Int      @map("city_id")
  createdAt DateTime @default(now()) @map("created_at")
  city      City     @relation(fields: [cityId], references: [id])
  @@map("user_saved_cities")
}